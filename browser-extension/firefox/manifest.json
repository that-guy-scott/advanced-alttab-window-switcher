{
  "name": "AATWS Browser Tabs",
  "version": "1.0.2",
  "description": "Search and activate browser tabs from AATWS.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "manifest_version": 3,
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aatws-tabs@G-dH.github.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
